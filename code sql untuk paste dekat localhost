CREATE DATABASE student_db;
USE student_db;

CREATE TABLE users (
    id INT PRIMARY KEY AUTO_INCREMENT,
    username VARCHAR(50) NOT NULL,
    password VARCHAR(255) NOT NULL
);

CREATE TABLE students (
    id INT PRIMARY KEY AUTO_INCREMENT,
    student_id VARCHAR(20) UNIQUE,
    full_name VARCHAR(100),
    gender VARCHAR(10),
    email VARCHAR(100),
    course VARCHAR(50),
    semester INT,
    enrollment_year INT,
    address TEXT,
    skills VARCHAR(255)
);

